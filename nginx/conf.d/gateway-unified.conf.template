# =========================================================
# 统一中转站单域名配置模板：model.yourdomain.com（同时承载控制台面板 + /v1/* SSE 流式 API）
# 使用方式：
#   DOMAIN="model.yourdomain.com"
#   sed "s/model.yourdomain.com/${DOMAIN}/g" nginx/conf.d/gateway-unified.conf.template | sudo tee "/etc/nginx/conf.d/${DOMAIN}.conf" >/dev/null
# =========================================================

server {
    listen 80;
    listen [::]:80;
    server_name model.yourdomain.com;

    # Certbot 自动续签验证路径（配合 webroot 模式免停机续签）
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name model.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/model.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/model.yourdomain.com/privkey.pem;

    # 现代 TLS 安全基线（优先 TLS 1.3 降低跨境弱网握手耗时）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # 允许大报文请求体（多模态图片 / 长上下文 / 参考视频与多图 Base64 上传）
    client_max_body_size 200m;
    client_body_buffer_size 1m;

    # 基础安全响应头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/model_access.log gateway_json;
    error_log  /var/log/nginx/model_error.log warn;

    # 登录、注册、兑换码接口加强防爆破限流
    location ~ ^/api/user/(login|register|topup|verification) {
        limit_req zone=panel_rate burst=10 nodelay;

        proxy_pass http://new_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Muse2API 生成的高清原图与 MP4 视频静态直链（无需 Bearer 鉴权，供 Markdown/浏览器直接渲染播放）
    location ^~ /v1/media/ {
        proxy_pass http://127.0.0.1:18610;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Muse2API 异步图片任务轮询接口直通
    location ^~ /v1/images/tasks {
        proxy_pass http://127.0.0.1:18610;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Meta Muse 极速 Web 上号器页面 & 交互接口（复用 quick-autoreg Playwright 引擎）
    location ^~ /muse-login {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location ^~ /muse-autoreg {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Muse2API 现代化深色运维面板 & Chrome 扩展导号接口 (/admin 与 /muse-admin)
    location = /muse-admin {
        return 302 /admin$is_args$args;
    }

    location = /admin {
        proxy_pass http://127.0.0.1:18610;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    location ^~ /admin/ {
        proxy_pass http://127.0.0.1:18610;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }

    # 大模型 API 推理端点（OpenAI / Anthropic / Gemini / Responses 等）
    location ~ ^/(v1|v1beta|pg|mj|suno|kling|v2)/ {
        limit_req zone=api_rate burst=40 nodelay;
        limit_conn api_conn 50;

        proxy_pass http://new_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ===== 核心：SSE 流式传输（打字机效果）必配项 =====
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        gzip off;

        # 延长超时，兜底慢速推理与深度思考模型（Thinking / Reasoning）
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # AWS Quick 批量上号器 & 号池管理面板（反代至 quickwork2api 本地回环端口）
    location ^~ /quick-admin {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # AWS Quick 全自动无头浏览器邮箱别名注册引擎（只需输入主 Gmail + 6位验证码）
    location ^~ /quick-autoreg {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # WorkBuddy2API 多号池运维面板 & 多平台管理界面 (/wb-admin/)
    location = /wb-admin {
        return 302 /wb-admin/$is_args$args;
    }

    location ^~ /wb-admin/ {
        rewrite ^/wb-admin(/.*)$ /panel$1 break;
        proxy_pass http://127.0.0.1:7863;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter '/panel/' '/wb-admin/';
        sub_filter_once off;
        sub_filter_types text/javascript application/javascript text/css;
        proxy_read_timeout 300s;
    }

    # 控制台前端、Playground 与其余路由
    location / {
        proxy_pass http://new_api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
