# =========================================================
# AI API 中转站生产环境变量模板
# 使用前执行: cp .env.example .env && chmod 600 .env
# 强烈建议将填好后的 .env 离线加密保存一份（换赠金机迁移必需！）
# =========================================================

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------
# 1. 安全密钥（务必使用 openssl rand -hex 32 生成！）
# 注意：上线后严禁随意更改 CRYPTO_SECRET，否则库里加密的上游 Key 将无法解密
# ---------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_SESSION
CRYPTO_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_CRYPTO

# ---------------------------------------------------------
# 2. MySQL 8.0 数据库配置
# 注意：密码尽量只用字母和数字，避免 @ / : ? 等 URL 特殊字符导致 DSN 解析异常
# ---------------------------------------------------------
MYSQL_DATABASE=newapi
MYSQL_USER=newapi
MYSQL_PASSWORD=REPLACE_WITH_STRONG_ALPHANUMERIC_DB_PASS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ALPHANUMERIC_ROOT_PASS

# ---------------------------------------------------------
# 3. Redis 7 配置
# ---------------------------------------------------------
REDIS_PASSWORD=REPLACE_WITH_STRONG_ALPHANUMERIC_REDIS_PASS

# ---------------------------------------------------------
# 4. New API 性能与行为参数
# ---------------------------------------------------------
# 批量聚合更新用户额度，降低高频并发下的 MySQL 写压力
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
# 启用错误日志便于排查上游 429/502/超时
ERROR_LOG_ENABLED=true
# 节点模式（单机保持 master 即可）
NODE_TYPE=master
# 禁用默认注册即送过大会员额度（请在后台精细配置）
MEMORY_CACHE_ENABLED=true

# ---------------------------------------------------------
# 5. 异地灾备配置（强烈推荐搭配免费的 Cloudflare R2，10GB 永久免费）
# 配置完 rclone config 后填写对应的 remote 名称与桶名
# ---------------------------------------------------------
RCLONE_REMOTE=r2:llm-gateway-backups
# 本地备份保留天数
BACKUP_RETENTION_DAYS=7
# 备份文件加密密码（用于 openssl 加密备份后再上传云端，留空则不加密）
BACKUP_ENCRYPT_PASSPHRASE=REPLACE_WITH_BACKUP_ENCRYPT_PASS

# ---------------------------------------------------------
# 6. Meta Muse 多模态 2API 服务配置（文本/生图/改图/生视频）
# ---------------------------------------------------------
MUSE2API_KEY=m2a_REPLACE_WITH_STRONG_KEY
MUSE2API_PUBLIC_BASE=https://model.yourdomain.com
MUSE2API_CONCURRENCY=4
