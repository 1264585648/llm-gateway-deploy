# =========================================================
# MySQL 8.0 优化配置（当前适配 b3-16 4C16G，若换 2C4G 机器可调回 768M）
# =========================================================
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# 内存控制：16G 机器分配 2G InnoDB Buffer Pool，大幅提升高并发查询与计费写入性能
innodb_buffer_pool_size = 2G
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT

# 连接与超时
max_connections = 300
wait_timeout = 600
interactive_timeout = 600
max_allowed_packet = 64M

# 禁用性能开销大且中小规模不需要的 binlog（已使用 mysqldump 定时异地备份）
# 如需做主从复制或 PITR 时间点恢复，可改为 log_bin = mysql-bin 并设 expire_logs_days
skip-log-bin

# 开启慢查询日志（方便求职复盘与 SQL 索引调优）
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1
